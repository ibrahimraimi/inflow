{
  "name": "@inflow/core",
  "version": "1.0.0",
  "private": true,
  "exports": {
    "./lib/*": {
      "types": "./src/lib/*.ts*",
      "default": "./src/lib/*.ts*"
    },
    "./server/*": {
      "types": "./src/server/*.ts*",
      "default": "./src/server/*.ts*"
    },
    "./components/*": {
      "types": "./src/components/*.ts*",
      "default": "./src/components/*.ts*"
    },
    "./configs/*": {
      "types": "./src/configs/*.ts",
      "default": "./src/configs/*.ts"
    }
  },
  "dependencies": {
    "@inflow/db": "workspace:*",
    "@inflow/types": "workspace:*",
    "better-auth": "^1.4.18",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "tailwind-merge": "^3.4.1",
    "@react-email/components": "^1.0.7",
    "@inflow/cache": "workspace:*",
    "@inflow/logger": "workspace:*",
    "axios": "^1.13.5",
    "mailersend": "^2.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "date-fns-tz": "^3.2.0",
    "next": "16.1.6",
    "ua-parser-js": "^2.0.9",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@inflow/config-typescript": "workspace:*",
    "typescript": "^5.9.3",
    "@types/react": "^19.2.14"
  }
}
