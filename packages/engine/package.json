{
  "name": "@inflow/engine",
  "version": "1.0.0",
  "description": "Core analytics tracking engine for Inflow Analytics",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun x tsdown --config tsdown.config.ts && bun x tsdown src/script.ts --format iife",
    "dev": "bun x tsdown --config tsdown.config.ts --watch",
    "lint": "biome check src"
  },
  "keywords": [
    "analytics",
    "tracking",
    "engine",
    "inflow"
  ],
  "author": "Inflow",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@types/node": "^22.5.0",
    "tsdown": "^0.21.7",
    "typescript": "^5.9.3"
  }
}
